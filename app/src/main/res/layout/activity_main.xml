<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F5FC"
    tools:context=".MainActivity">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#6C4AB6"
        android:elevation="4dp"
        app:title="Quản lý sinh viên"
        app:titleTextColor="#FFFFFF" />

    <!-- Form title -->
    <TextView
        android:id="@+id/maintitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingBottom="3dp"
        android:text="THÔNG TIN SINH VIÊN"
        android:textColor="#6C4AB6"
        android:textSize="17sp"
        android:textStyle="bold" />

    <!-- Row 1: Student ID and Class ID -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp">

        <EditText
            android:id="@+id/edtMaSV"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#6C4AB6"
            android:hint="Mã sinh viên"
            android:inputType="text"
            android:singleLine="true"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/edtLop"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:backgroundTint="#6C4AB6"
            android:hint="Mã lớp"
            android:inputType="text"
            android:singleLine="true"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- Row 2: Name and date of birth -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp">

        <EditText
            android:id="@+id/edtHoTen"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.5"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#6C4AB6"
            android:hint="Họ tên sinh viên"
            android:inputType="textPersonName"
            android:singleLine="true"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/edtNgaySinh"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:backgroundTint="#6C4AB6"
            android:hint="Ngày sinh"
            android:inputType="text"
            android:singleLine="true"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- Gender -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Giới tính:"
            android:textColor="#333333"
            android:textSize="14sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgGioiTinh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbNam"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nam"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/rbNu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Nữ"
                android:textSize="14sp" />

        </RadioGroup>

    </LinearLayout>

    <!-- Address -->
    <EditText
        android:id="@+id/edtDiaChi"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginHorizontal="10dp"
        android:backgroundTint="#6C4AB6"
        android:hint="Địa chỉ"
        android:inputType="textPostalAddress"
        android:singleLine="true"
        android:textSize="14sp" />

    <!-- Phone number -->
    <EditText
        android:id="@+id/edtSoDienThoai"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginHorizontal="10dp"
        android:backgroundTint="#6C4AB6"
        android:hint="Số điện thoại"
        android:inputType="phone"
        android:singleLine="true"
        android:textSize="14sp" />

    <!-- Add, Update, Delete buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp">

        <Button
            android:id="@+id/btnThem"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:backgroundTint="#4CAF50"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="Thêm"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnSua"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:backgroundTint="#2196F3"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="Sửa"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnXoa"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:backgroundTint="#F44336"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="Xóa"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- Student list title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:text="DANH SÁCH SINH VIÊN"
        android:textColor="#6C4AB6"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Student list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSinhVien"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF"
        android:padding="5dp"
        android:clipToPadding="false" />

</LinearLayout>