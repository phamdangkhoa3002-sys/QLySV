<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvItemMaSV"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mã sinh viên:"
            android:textColor="#6C4AB6"
            android:textStyle="bold"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/tvItemTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Họ tên:"
            android:textColor="#222222"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginTop="5dp"/>

        <TextView
            android:id="@+id/tvItemDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ngày sinh:"
            android:textColor="#555555"/>

        <TextView
            android:id="@+id/tvItemType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Giới tính:"
            android:textColor="#555555"/>

        <TextView
            android:id="@+id/tvItemContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Địa chỉ:"
            android:textColor="#555555"/>

        <TextView
            android:id="@+id/tvItemLop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mã lớp:"
            android:textColor="#555555"/>

        <TextView
            android:id="@+id/tvItemSoDienThoai"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Số điện thoại:"
            android:textColor="#555555"/>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/btnItemSua"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Sửa"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:backgroundTint="#2196F3" />

            <Button
                android:id="@+id/btnItemXoa"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:text="Xóa"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:backgroundTint="#F44336" />

        </LinearLayout>


    </LinearLayout>




</androidx.cardview.widget.CardView>
